{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JetBot semantic object observations v1",
  "type": "object",
  "required": ["version", "frame_id", "stamp", "objects"],
  "properties": {
    "version": {"const": 1},
    "frame_id": {"type": "string", "minLength": 1},
    "stamp": {"type": "number", "description": "Measurement simulation seconds"},
    "sequence": {"type": "integer", "minimum": 0},
    "source": {"enum": ["ground_truth", "vision"]},
    "objects": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/object"}}
  },
  "$defs": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "object": {
      "type": "object",
      "required": ["object_id", "class_name", "confidence", "position", "orientation_xyzw", "dimensions", "source"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "class_name": {"enum": ["shelf", "wall", "box", "pallet", "barrier", "cart", "sign", "person"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "position": {"$ref": "#/$defs/vector3"},
        "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}, "description": "Unit quaternion, box axes in frame_id"},
        "dimensions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 50}, "description": "Full side lengths in meters"},
        "source": {"enum": ["ground_truth", "vision"]},
        "row_index": {"type": "integer", "minimum": 1, "maximum": 99, "description": "Optional stable shelf row label from the site catalog; not robot-relative order"},
        "label": {"type": "string", "maxLength": 128}
      }
    }
  }
}
